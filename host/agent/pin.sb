(version 1)
(allow default)
(deny process-exec (literal "/bin/launchctl") (literal "/usr/bin/at") (literal "/usr/bin/crontab") (literal "/usr/bin/batch"))
(deny network-bind (local ip "*:@AUTH_BROKER_PORT@"))
(deny file-read* (subpath "/Volumes"))
(allow file-read-metadata)
(deny file-write* (require-not (subpath "@AGENT_HOME@")))
(allow file-write* (literal "/dev/null") (regex #"^/dev/tty") (subpath "/private/var/folders"))
(deny file-write* (subpath "@AGENT_HOME@/.ssh") (literal "@AGENT_HOME@/.zshenv") (literal "@AGENT_HOME@/.zprofile") (literal "@AGENT_HOME@/.zshrc") (literal "@AGENT_HOME@/.zlogin") (literal "@AGENT_HOME@/.profile") (literal "@AGENT_HOME@/.bash_profile") (literal "@AGENT_HOME@/.bash_login") (literal "@AGENT_HOME@/.bashrc"))
