<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.underground.gh-broker</string>
  <key>UserName</key>
  <string>@GH_BROKER_USER@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@OMP@</string>
    <string>@ROOT@/code/gh-broker/server.ts</string>
    <string>@GH@</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@GH_BROKER_HOME@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@ROOT@/logs/gh-broker.log</string>
  <key>StandardErrorPath</key>
  <string>@ROOT@/logs/gh-broker.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@GH_BROKER_HOME@</string>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
    <key>BUN_BE_BUN</key>
    <string>1</string>
  </dict>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
</dict>
</plist>
