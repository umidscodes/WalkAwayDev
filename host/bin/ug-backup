#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-backup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
restic_pin=$(ug_pin "$src/VERSIONS" restic)
data=$HOME/$(ug_fact owner_data)
restic_bin="$data/restic/$restic_pin/restic"
backup="$data/backup"
config="$backup/config"
agent_tar=${UG_AGENT_HOME_TAR:-$(ug_fact root)/code/bin/agent-home-tar}

log() { printf '%s ug-backup: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
fail() {
  log "$*"
  exit 1
}

restic_hint() {
  case $1 in
    11) printf ', which can mean the repo is locked by another restic or a stale lock' ;;
    12) printf ', which can mean a wrong password' ;;
    130) printf ', which means it was cancelled' ;;
  esac
}

[[ -n $restic_pin && -x $restic_bin ]] || fail "the pinned restic $restic_bin is missing; run host/bin/ug-setup"
[[ -s $backup/password ]] || fail "the backup password $backup/password is missing; run host/bin/ug-setup"
[[ -f $config ]] || fail "no $config; write it in the format that backup_target_read in host/lib/backup-target.bash reads"
export RESTIC_PASSWORD_FILE="$backup/password"

repo=""
# shellcheck source=host/lib/backup-target.bash disable=SC1091
source "$src/host/lib/backup-target.bash"
backup_target_read "$config" || exit 1
backup_target_wake || exit 1

status=0
what="does not open"
err=$("$restic_bin" -r "$repo" cat config 2>&1 >/dev/null) || status=$?
if [[ $status -eq 10 ]]; then
  status=0
  what="cannot be made"
  err=$("$restic_bin" -r "$repo" init 2>&1 >/dev/null) || status=$?
  [[ $status -ne 0 ]] || log "made the repo $repo"
fi
if [[ $status -ne 0 ]]; then
  log "the repo $repo $what (restic exit $status$(restic_hint "$status")): ${err//$'\n'/ }"
elif [[ ! -x $agent_tar ]]; then
  log "the agent home reader $agent_tar is missing; run: host/bin/ug-setup"
  status=1
else
  "$restic_bin" -r "$repo" backup --quiet --tag ug-agent --stdin-filename ug-agent-home.tar --stdin-from-command -- sudo -n "$agent_tar"
  status=$?
  if [[ $status -eq 0 ]]; then
    date +%s >"$backup/last"
    log "saved the agent home to $repo"
  else
    log "the agent home was not saved (restic exit $status$(restic_hint "$status")); a failed read stores no snapshot"
  fi
fi

backup_target_sleep
[[ $status -eq 0 ]]
