#!/usr/bin/env bash
set -uo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-watch\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
data=$HOME/$(ug_fact owner_data)
broker_status=${UG_GH_BROKER_STATUS:-$(ug_fact root)/$(ug_fact gh_broker_status)}
broker_log=$(ug_service_expand "$(ug_service_field gh-broker log)")
watch=$data/watch
status=$watch/status
ping_file=$watch/ping
retry=${UG_WATCH_RETRY_SECONDS:-60}
broker_stale=120
backup_stale=$((36 * 3600))

log() { printf '%s ug-watch: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

record_value() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1; }

job_problem() {
  local target=$1 name=$2 out code
  out=$(launchctl print "$target" 2>/dev/null) || { printf '%s: launchd has no job %s\n' "$name" "$target"; return; }
  code=$(sed -n 's/^[[:space:]]*last exit code = \([0-9][0-9]*\).*/\1/p' <<<"$out" | head -n 1)
  [[ -z $code || $code == 0 ]] || printf '%s: its last run exited with %s\n' "$name" "$code"
}

problems() {
  local now at failed label name scope user template health log inputs agent_input url target shown want runs sock
  now=$(date +%s)
  at=$(record_value "$broker_status" at)
  if [[ ! $at =~ ^[0-9]+$ ]] || (( now - 10#$at > broker_stale )); then
    printf 'gh-broker: its refresh loop wrote no status in the last %s s; see sudo cat %s\n' "$broker_stale" "$broker_log"
  else
    failed=$(record_value "$broker_status" failed)
    [[ -z $failed ]] || printf 'gh-broker: the last refresh failed for %s; see sudo cat %s\n' "$failed" "$broker_log"
    sock=$(record_value "$broker_status" socket)
    [[ $sock == ok ]] || printf 'gh-broker: its socket did not answer its own check (%s); see sudo cat %s\n' "${sock:-no socket line}" "$broker_log"
  fi
  at=$(cat "$data/backup/last" 2>/dev/null)
  if [[ ! $at =~ ^[0-9]+$ ]] || (( now - 10#$at > backup_stale )); then
    printf 'backup: no good backup in the last 36 hours; see %s\n' "$data/backup/backup.log"
  fi
  while IFS='|' read -r label name scope user template health log inputs agent_input; do
    if [[ $scope == daemon ]]; then
      want=root
      [[ $user == root ]] || want=$(ug_fact "$user")
      runs=$(ug_service_runs_as "$label" "$want") || printf '%s: %s\n' "$name" "$runs"
    fi
    case ${health%% *} in
      http)
        if [[ $health == *@GATEWAY@* && -z $(record_value "$data/addresses" gateway) ]]; then
          printf '%s: %s has no gateway= line\n' "$name" "$data/addresses"
          continue
        fi
        url=$(ug_service_expand "${health#* }")
        target=${url#http://}
        target=${target%%/*}
        shown=$target
        [[ $target == 127.0.0.1:* ]] && shown="port ${target#127.0.0.1:}"
        ug_http_answers "$url" 2>/dev/null || printf '%s: no answer on %s\n' "$name" "$shown"
        ;;
      port)
        target=$(ug_service_expand "${health#port }")
        ug_port_answers "${target%:*}" "${target##*:}" 2>/dev/null || printf '%s: no answer on port %s\n' "$name" "${target##*:}"
        ;;
      launchd|pf)
        target="system/$label"
        [[ $scope == agent ]] && target="gui/$UID/$label"
        job_problem "$target" "$name"
        ;;
    esac
  done < <(ug_services)
}

found=$(problems)
if [[ -n $found ]]; then
  sleep "$retry"
  found=$(problems)
fi

url=$(head -n 1 "$ping_file" 2>/dev/null)
report=$found
if [[ ! $url =~ ^https://[^[:space:]]+$ ]]; then
  report+="${report:+$'\n'}watch: $ping_file has no https ping address, so nothing outside this mac alerts you"
fi

tmp=$(mktemp "$watch/.status.XXXXXX") || { log "cannot write in $watch"; exit 1; }
if ! { printf 'at=%s\n%s%s' "$(date +%s)" "$report" "${report:+$'\n'}" >"$tmp" && mv -f "$tmp" "$status"; }; then
  rm -f "$tmp"
  log "cannot write $status"
  exit 1
fi
[[ -z $found ]] || log "${found//$'\n'/; }"

[[ $url =~ ^https://[^[:space:]]+$ ]] || exit 0
ping_config() {
  local u=${1//\\/\\\\}
  printf 'url = "%s"\n' "${u//\"/\\\"}"
}
if [[ -z $found ]]; then
  curl -fsS -o /dev/null --max-time 10 --retry 3 -K <(ping_config "$url") || log "the ping to the outside check failed"
else
  printf '%s\n' "$found" | awk -F: '!seen[$1]++ { print $1 }' | curl -fsS -o /dev/null --max-time 10 --retry 3 --data-binary @- -K <(ping_config "$url/fail") || log "the failure ping to the outside check failed"
fi
